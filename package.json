{
  "name": "scendey-waitlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && prisma generate && next build",
    "start": "node init && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/waitlist-validation.test.ts",
