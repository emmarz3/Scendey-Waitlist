    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/generate-prisma.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.0",
    "dotenv": "^8.2.0",
    "gsap": "^3.14.2",
    "jose": "^6.1.0",
    "next": "^15.5.6",
    "node-fetch": "^3.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
