DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"
# Create the first admin with `npm run db:seed` using these local-only values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-local-only"
# Optional transactional email provider; without this, links are printed only in development.
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="SCENDEY <updates@example.com>"
# Owner-controlled campaign settings
CAMPAIGN_PERKS=""
CANONICAL_URL="http://localhost:3000"
# Protect POST /api/cron/campaigns with a random bearer secret.
CRON_SECRET="replace-with-a-separate-random-secret"
