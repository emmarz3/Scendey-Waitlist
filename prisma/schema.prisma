generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WaitlistEntry {
  id              String       @id @default(cuid())
  role            String
  email           String       @unique
  name            String?
  brandName       String?
  category        String?
  sellingStatus   String?
  handleOrUrl     String?
  location        String?
  phone           String?
  salesBlocker    String?
  interests       String       @default("[]")
  source          String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  referralCode    String?      @unique
  invitationCode  String?
  referredById    String?
  referredBy      WaitlistEntry? @relation("ReferralAttribution", fields: [referredById], references: [id])
  referrals       WaitlistEntry[] @relation("ReferralAttribution")
  consent         Boolean      @default(false)
  consentVersion  String?
  consentAt       DateTime?
  status          String       @default("PENDING")
  verifiedAt      DateTime?
  invitationSentAt DateTime?
  unsubscribedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tokens          EmailVerificationToken[]
  events          CampaignRecipient[]
  statusHistory   WaitlistStatusEvent[]
  @@index([role, status, createdAt])
  @@index([source, createdAt])
  @@index([invitationCode, createdAt])
}

model WaitlistStatusEvent {
  id        String   @id @default(cuid())
  entryId   String
  from      String
  to        String
  adminId   String?
  createdAt DateTime @default(now())
  entry     WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId, createdAt])
}

model EmailVerificationToken {
  id        String       @id @default(cuid())
  digest    String       @unique
  purpose   String
  entryId   String
  entry     WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  @@index([entryId, purpose, expiresAt])
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredEntryId String  @unique
  confirmedAt    DateTime?
  flaggedAt      DateTime?
  flagReason     String?
  createdAt      DateTime @default(now())
  @@index([referrerId, confirmedAt])
}

model Invitation {
  id        String   @id @default(cuid())
  code      String   @unique
  batch     String?
  role      String?
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model Campaign {
  id        String         @id @default(cuid())
  name      String
  subject   String
  segment   String
  status    String         @default("DRAFT")
  scheduledAt DateTime?
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  entryId    String
  event      String   @default("QUEUED")
  detail     String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entry      WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@unique([campaignId, entryId])
  @@index([entryId, event])
}

model ContactRequest {
  id        String   @id @default(cuid())
  email     String
  name      String?
  subject   String
  message   String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  target    String?
  metadata  String?
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

model CampaignSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  role      String?
  source    String?
  entryId   String?
  createdAt DateTime @default(now())
  @@index([name, createdAt])
  @@index([role, source, createdAt])
}
